      "mutate": "entries[0].type = \"automation\" while resourceKey is studio.*",
      "expect": "RESOURCE_FEED_INVALID (namespace/type mismatch)"
    },
    {
      "id": "N4",
      "mutate": "entries[0].packageUrl = \"packages/<another sha256>\"",
      "expect": "RESOURCE_FEED_INVALID"
    },
    {
      "id": "N5",
      "mutate": "entries[0].publisher = \"other-publisher\" (signature untouched)",
      "expect": "RESOURCE_SIGNATURE_INVALID"
    },
    {
      "id": "N6",
      "mutate": "trust.keys[0].role = \"community\"",
      "expect": "RESOURCE_FEED_INVALID (role must be resource)"
    },
    {
      "id": "N7",
      "mutate": "verify a catalog-v2 community release signature as a resources release",
      "expect": "RESOURCE_SIGNATURE_INVALID (domain separation)"
    },
    {
      "id": "N8",
      "mutate": "snapshot2.previous.sha256 altered",
      "expect": "RESOURCE_FEED_CHAIN_INVALID"
    },
    {
      "id": "N9",
      "mutate": "validUntil <= generatedAt",
      "expect": "RESOURCE_FEED_INVALID"
    },
    {
      "id": "N10",
      "mutate": "entries[0].size = 26214401",
      "expect": "RESOURCE_FEED_INVALID"
    },
    {
      "id": "N11",
      "mutate": "entries[1].size = 204801 (automation over its type maximum; still within 25 MiB)",
      "expect": "RESOURCE_FEED_INVALID (size > maxBytes(type), feed 4/9, A-1)"
    },
    {
      "id": "N12",
      "mutate": "entries[1].sha256 = entries[0].sha256 with entries[1].size left different",
      "expect": "RESOURCE_FEED_INVALID (same sha256 must have same size, feed 3, A-6)"
    },
    {
      "id": "N13",
      "mutate": "entries[0].access = \"installation\", packageUrl = null",
      "expect": "RESOURCE_FEED_INVALID (v1 admits only access \"public\", feed 8, A-4)"
    },
