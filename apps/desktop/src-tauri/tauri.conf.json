{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runly",
  "version": "0.3.1",
  "identifier": "com.racoondevs.runlyerp",
  "build": {
    "beforeDevCommand": "pnpm dev:host",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build:host",
    "frontendDist": "../native-host/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'",
      "capabilities": [
        "desktop-shell",
        "desktop-remote"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Runly para Windows",
    "category": "Business",
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
