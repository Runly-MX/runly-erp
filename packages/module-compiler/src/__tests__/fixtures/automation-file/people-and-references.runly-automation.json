{
  "format": "runly.automation",
  "version": 1,
  "exportedAt": "2026-11-01T12:00:00.000Z",
  "automation": {
    "label": "Lead con personas y referencias de otra empresa",
    "trigger": {
      "type": "webhook",
      "fields": [
        {
          "key": "name",
          "label": "Nombre"
        },
        {
          "key": "email",
          "label": "Correo"
        }
      ]
    },
    "steps": [
      {
        "service": "runly.notifications:notifications.send",
        "args": {
          "userIds": {
            "from": "value",
            "value": [
              "11111111-1111-4111-8111-111111111111"
            ]
          },
          "title": {
            "from": "template",
            "template": "Lead {{name}}"
          }
        }
      },
      {
        "type": "approval",
        "approvers": [
          "11111111-1111-4111-8111-111111111111"
        ],
        "message": "Aprobar el lead",
        "channel": "ventas"
      },
      {
        "service": "runly.chat:messages.post",
        "args": {
          "channel": {
            "from": "value",
            "value": "ventas"
          },
          "text": {
            "from": "template",
            "template": "Lead {{name}} aprobado"
          }
        }
      },
      {
        "service": "runly.notifications:email.send",
        "args": {
          "to": {
            "from": "value",
            "value": "externo@otra-empresa.example"
          },
          "subject": {
            "from": "template",
            "template": "Lead {{name}}"
          },
          "body": {
            "from": "template",
            "template": "Hola"
          },
          "fileId": {
            "from": "value",
            "value": "22222222-2222-4222-8222-222222222222"
          }
        }
      },
      {
        "service": "runly.documents:documents.generate",
        "args": {
          "kind": {
            "from": "value",
            "value": "contrato"
          },
          "templateId": {
            "from": "value",
            "value": "33333333-3333-4333-8333-333333333333"
          }
        }
      },
      {
        "service": "runly.contacts:contacts.read",
        "args": {
          "id": {
            "from": "value",
            "value": "44444444-4444-4444-8444-444444444444"
          }
        }
      }
    ],
    "enabled": false
  }
}
