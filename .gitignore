# Dependencies
node_modules
.pnpm-store

# pnpm workspace artifacts
runly-erp-starter@*

# Environment — only sanitized templates belong in Git
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.dump
*.backup
docs/private/
.codebase-memory/

# MCP server config (may contain URLs with tokens)
.mcp.json

# Persistent local credentials and per-environment Firebase configuration
.secrets/
**/google-services.json
**/*firebase-adminsdk*.json

# OS
.DS_Store
Thumbs.db

# Build outputs
dist
build
coverage
apps/api/bundles/*.js
apps/api/bundles/*.js.json

# Module folders are instance data, not source: the Module Builder, ZIP uploads
# and installs write here (plus .staging/.previews/.backups/.locks). Only the
# empty folders are kept. modules/official is legacy and unused.
modules/custom/*
!modules/custom/.gitkeep
modules/official/*
!modules/official/.gitkeep

# Tauri native build
apps/desktop/src-tauri/target
apps/desktop/src-tauri/tauri.native.generated.json
# Recreated by tauri-build; platform-specific output is not source code.
apps/desktop/src-tauri/gen/schemas/
apps/desktop/src-tauri/permissions/autogenerated/
# Mobile distribution artifacts and signing material stay local.
apps/desktop/src-tauri/**/*.apk
apps/desktop/src-tauri/**/*.aab
apps/desktop/src-tauri/**/*.ipa
apps/desktop/src-tauri/**/*.jks
apps/desktop/src-tauri/**/*.keystore

# Prisma generated client
prisma/generated

# ffmpeg.wasm core (~30MB binary) — copied from @ffmpeg/core by
# apps/desktop's postinstall script on every `pnpm install`, never committed.
apps/desktop/public/ffmpeg/

# Database / logs
*.db
*.db-journal
*.log
pnpm-debug.log*

# Editor
.idea
*.suo
*.ntvs*
*.njsproj
*.sln

# Local task/runtime artifacts
.tmp/
*.tmp
*.pid
task*-*.json
task*-*.headers
task*-*.log
task*-*.pid
task*.tokens.json

# Git worktrees
.worktrees/

# Installer local Supabase runtime artifacts
infra/installer/.supabase-local/
infra/installer/livekit/livekit.yaml
infra/installer/livekit/Caddyfile
infra/installer/livekit/reverse-proxy.nginx.conf
infra/installer/docker-compose.hairpin.yml

# Superpowers brainstorming scratch
.superpowers/

# Per-machine record of the last commit released per Docker image (build-push.mjs).
infra/docker/.release-state.json

# Local E2E runs (Playwright screenshots, state)
.e2e/

.artifacts/shared-release/
.artifacts/shared-consumer/
.artifacts/shared-consumer-source-*/
apps/desktop/native-host/dist/
# Native density icons and bundled legacy mark are derived by brand:native.
apps/desktop/src-tauri/gen/android/app/src/main/res/mipmap-*/ic_launcher*.png
apps/desktop/src-tauri/gen/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher*.xml
apps/desktop/src-tauri/gen/android/app/src/main/res/values/ic_launcher_background.xml
apps/desktop/native-host/shell/runly-mark.svg
# Kotlin daemon/session diagnostics and machine-specific compiler state.
.kotlin/
kotlin-compiler-*.log
# Local Studio verification artifacts (screenshots, bundles and logs).
.artifacts/studio/
.artifacts/realtime-2/
infra/installer/.runly-installer/
.artifacts/notifications/
.artifacts/rc/
.artifacts/rehearsal/
